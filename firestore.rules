rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'faradilashafa@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGroupId(id) {
      return id in ['group1', 'group2', 'group3', 'group4', 'group5', 'group6'];
    }

    function isValidGroupData(data) {
      return (
        (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 100)) &&
        (!('className' in data) || (data.className is string && data.className.size() <= 50)) &&
        (!('groupNumber' in data) || (data.groupNumber in ['1', '2', '3', '4', '5', '6'])) &&
        (!('members' in data) || (data.members is list && data.members.size() <= 10)) &&
        (!('status' in data) || (data.status in ['not_started', 'in_progress', 'submitted', 'graded', 'revision']))
      );
    }

    function isValidScoreData(data) {
      return (
        data.totalScore is number &&
        data.totalScore >= 0 &&
        data.totalScore <= 100 &&
        (!('objectIdentification' in data) || (data.objectIdentification is number && data.objectIdentification >= 0 && data.objectIdentification <= 30)) &&
        (!('visualReasoning' in data) || (data.visualReasoning is number && data.visualReasoning >= 0 && data.visualReasoning <= 25)) &&
        (!('completeness' in data) || (data.completeness is number && data.completeness >= 0 && data.completeness <= 20)) &&
        (!('presentation' in data) || (data.presentation is number && data.presentation >= 0 && data.presentation <= 15)) &&
        (!('reflection' in data) || (data.reflection is number && data.reflection >= 0 && data.reflection <= 10))
      );
    }

    // Student Group submissions & progress
    match /groups/{groupId} {
      allow read: if isValidGroupId(groupId);
      allow create, update: if isValidGroupId(groupId) && (
        isAdmin() ||
        (isValidGroupData(request.resource.data) && (
          // Students cannot self-assign status 'graded'
          request.resource.data.status != 'graded'
        ))
      );
      allow delete: if isAdmin();
    }

    // Teacher scoring and evaluation
    match /scores/{groupId} {
      allow read: if isValidGroupId(groupId);
      allow write: if isAdmin() && isValidGroupId(groupId) && isValidScoreData(request.resource.data);
    }

    // Settings (group areas, imagery URLs, class timer)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin collection for role validation
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
